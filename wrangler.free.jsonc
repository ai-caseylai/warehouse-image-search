{
  // 免費 Demo 設定：Workers Free + KV + Vectorize 免費 tier + Jina CLIP v2 + Workers AI
  // 用法：wrangler deploy --config wrangler.free.jsonc
  // 注意：正式版仍然用 wrangler.jsonc（R2 + DashScope），兩者互不影響。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-vector-search-free",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },

  "vars": {
    "EMBED_PROVIDER": "jina",
    "EMBED_DIMENSIONS": "256",
    "JINA_MODEL": "jina-clip-v2",
    "DUP_THRESHOLD": "0.82",
    "VISION_PROVIDER": "workers-ai",
    "WORKERS_AI_VISION_MODEL": "@cf/llava-hf/llava-1.5-7b-hf"
  },

  // 喺 Cloudflare 建立 KV namespace 後，將 id 貼落下面：
  //   npx wrangler kv namespace create IMAGES --config wrangler.free.jsonc
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "e6323d1e991c4d738d094aad18675494" }
  ],

  // 建立 256 維 index（唔可以同 R2 版個 768 維 index 共用）：
  //   npx wrangler vectorize create image-vectors-free --dimensions=256 --metric=cosine
  "vectorize": [
    { "binding": "VECTOR_INDEX", "index_name": "image-vectors-free" }
  ],

  // Workers AI（免費 10,000 neurons/day；用嚟做 AI 估尺寸）
  "ai": { "binding": "AI" }
}
